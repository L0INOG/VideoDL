<?xml version="1.0" encoding="utf-8"?>
<!-- 复刻 design/index.html + style.css 设计稿（未登录下载版，无进度/历史区） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- 背景光斑装饰 -->
    <View
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_gravity="top|start"
        android:translationX="-70dp"
        android:translationY="-60dp"
        android:background="@drawable/blob_a" />

    <View
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="130dp"
        android:translationX="80dp"
        android:background="@drawable/blob_b" />

    <!-- 主内容 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.03"
            android:textColor="@color/ink" />

        <!-- 输入卡片：28dp 圆角 + 10dp 内边距；44dp 圆形按钮几何上正好嵌进圆角曲线 -->
        <LinearLayout
            android:id="@+id/inputCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:orientation="vertical"
            android:padding="10dp"
            android:background="@drawable/bg_input_card"
            android:elevation="0dp">

            <EditText
                android:id="@+id/input"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:background="@android:color/transparent"
                android:gravity="top"
                android:hint="粘贴链接..."
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textNoSuggestions"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/placeholder"
                android:textSize="16sp" />

            <FrameLayout
                android:id="@+id/parseBtn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_parse_btn"
                android:elevation="0dp"
                android:outlineProvider="none"
                android:contentDescription="@string/app_name">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_arrow"
                    android:importantForAccessibility="no" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="支持平台"
            android:textSize="13.5sp"
            android:textColor="@color/ink_2" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iconBili"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:src="@drawable/bilibili"
                android:elevation="4dp"
                android:contentDescription="哔哩哔哩" />

            <ImageView
                android:id="@+id/iconDouyin"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginStart="14dp"
                android:src="@drawable/douyin"
                android:elevation="4dp"
                android:contentDescription="抖音" />

            <ImageView
                android:id="@+id/iconKs"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginStart="14dp"
                android:src="@drawable/kuaishou"
                android:elevation="4dp"
                android:contentDescription="快手" />

            <ImageView
                android:id="@+id/iconXhs"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginStart="14dp"
                android:src="@drawable/xiaohongshu"
                android:elevation="4dp"
                android:contentDescription="小红书" />
        </LinearLayout>
    </LinearLayout>

    <!-- 右下角关于按钮 -->
    <ImageButton
        android:id="@+id/aboutBtn"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="26dp"
        android:background="@android:color/transparent"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_info"
        android:alpha="0.28"
        android:contentDescription="关于" />
</FrameLayout>
